{
  "manifest_version": 3,
  "name": "Salesforce Dev Toolkit",
  "version": "1.0.0",
  "description": "Advanced Salesforce developer toolkit - SOQL Builder, Metadata Explorer, Data Loader, Schema Viewer, AI Assistant and more.",
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "tabs",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.lightning.force.com/*",
    "https://*.my.salesforce.com/*",
    "https://login.salesforce.com/*",
    "https://test.salesforce.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Salesforce Dev Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.force.com/*",
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*"
      ],
      "js": [
        "content/content-script.js"
      ],
      "css": [
        "content/content-styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
